# Configurações da Gráfica OS
PORT=3010
NODE_ENV=development

# Banco de Dados PostgreSQL
DATABASE_URL=postgres://postgres:senha_grafica@localhost:5432/grafica_db

# Painel Administrativo Credenciais
PAINEL_USUARIO=admin
PAINEL_SENHA=troque-esta-senha

# Evolution API / WhatsApp
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave_global_evolution
EVOLUTION_INSTANCE=grafica
EVOLUTION_WEBHOOK_SECRET=segredo_webhook_grafica

# IA Conversacional (Gemini Flash-Lite)
IA_CONVERSACIONAL_ATIVA=true
GEMINI_API_KEY=sua_chave_gemini_aqui
